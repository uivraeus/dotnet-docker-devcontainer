// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": ".Net/Docker",
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {},
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/devcontainers/features/python:1": {}
	},

	"postCreateCommand": ".devcontainer/postCreateCommand.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				//"ms-azuretools.vscode-containers"
			]
		}
	},
	"mounts": [
		"source=aws-workspaces-claude-home,target=/home/vscode/.claude,type=volume", // Retain claude data accross container rebuilds
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude", // Make ~/.claude.json end up in persistent ~/.claude/ mount
	},
}
